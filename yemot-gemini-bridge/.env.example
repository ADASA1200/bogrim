# Comments must be on their own lines (systemd's EnvironmentFile does not support trailing comments).

# ---- required -------------------------------------------------------------
# Key from a Google AI Studio project with billing enabled.
GEMINI_API_KEY=
# The static public IPv4 that Yemot reaches (also advertised in the SDP).
PUBLIC_IP=203.0.113.7
# 16-64 chars [A-Za-z0-9_.-]. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
# Put the SAME value in Yemot's routing_extension (Yemot forbids @ & : there).
ACCESS_TOKEN=

# ---- model ------------------------------------------------------------------
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Charon
# Google Search grounding (web search).
ENABLE_GOOGLE_SEARCH=true
# fetch_url tool (SSRF-hardened).
ENABLE_FETCH_URL=true
# End-of-speech silence in ms; Google recommends 500-800. Same value as the proven SMSBOTAI bridge.
VAD_SILENCE_MS=800
VAD_START_SENSITIVITY=HIGH
VAD_END_SENSITIVITY=HIGH
# Line tuning copied from the proven bridge: frames quieter than this RMS (16 kHz PCM) are sent as silence,
# and Gemini's output is scaled by OUTPUT_VOLUME. Set INPUT_NOISE_GATE_RMS=0 / OUTPUT_VOLUME=1.0 to disable.
INPUT_NOISE_GATE_RMS=200
OUTPUT_VOLUME=0.4
# '#' on the caller's keypad hangs up. Hang up when no RTP arrives from the caller for this many seconds.
HANGUP_ON_HASH=true
RTP_SILENCE_TIMEOUT=10
TZ_NAME=Asia/Jerusalem
# true logs what callers/model say (privacy!).
LOG_TRANSCRIPTS=false
# SYSTEM_PROMPT_FILE=/path/prompt.txt
# SYSTEM_PROMPT_EXTRA=Business details appended to the built-in Hebrew prompt.
# GREETING_PROMPT=...

# ---- SIP / RTP ---------------------------------------------------------------
SIP_BIND=0.0.0.0
# Yemot's routing_ip default; change together with routing_ip_port.
SIP_PORT=5060
RTP_PORT_MIN=10000
# Open UDP range; 2 ports per concurrent call are reserved.
RTP_PORT_MAX=10199
# Empty = use the first G.711 codec the caller offers (as pyVoIP does). Or e.g. PCMA,PCMU to force an order.
CODEC_PREFERENCE=
# Extra layer: only these sources may INVITE.
# ALLOWED_SOURCE_NETWORKS=198.51.100.0/24,203.0.113.9

# ---- limits --------------------------------------------------------------------
MAX_CALLS=5
MAX_CALL_SECONDS=1800

# ---- optional status endpoint -----------------------------------------------------
# STATUS_PORT=8080
# >=16 chars; GET /status with "Authorization: Bearer <token>", /healthz is open.
# STATUS_TOKEN=

# ---- optional: ring this bridge via a registered Yemot SIP account (type=sip mode) ----
# YEMOT_REGISTER_HOST=
# YEMOT_REGISTER_PORT=5060
# accountID returned by CreateSipAccount.
# YEMOT_SIP_USER=
# YEMOT_SIP_PASSWORD=
# YEMOT_REGISTER_EXPIRES=120
