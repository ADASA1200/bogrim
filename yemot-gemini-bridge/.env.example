# ---- required -------------------------------------------------------------
GEMINI_API_KEY=                 # key from a Google AI Studio project with billing enabled
PUBLIC_IP=203.0.113.7           # the static public IPv4 Yemot will reach (also goes into the SDP)
ACCESS_TOKEN=                   # 16-64 chars [A-Za-z0-9_.-]; generate: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
                                # Put the SAME value in Yemot's routing_extension (Yemot forbids @ & : there)

# ---- model ------------------------------------------------------------------
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
ENABLE_GOOGLE_SEARCH=true       # Google Search grounding (web search)
ENABLE_FETCH_URL=true           # fetch_url tool (SSRF-hardened)
VAD_SILENCE_MS=700              # end-of-speech silence; 500-800 recommended by Google
TZ_NAME=Asia/Jerusalem
LOG_TRANSCRIPTS=false           # true logs what callers/model say (privacy!)
# SYSTEM_PROMPT_FILE=/path/prompt.txt   # replaces the built-in Hebrew prompt
# SYSTEM_PROMPT_EXTRA=...               # appended to it (business details etc.)
# GREETING_PROMPT=...

# ---- SIP / RTP ---------------------------------------------------------------
SIP_BIND=0.0.0.0
SIP_PORT=5060                   # Yemot's routing_ip default; change together with routing_ip_port
RTP_PORT_MIN=10000
RTP_PORT_MAX=10199              # open UDP range; 2 ports per concurrent call are reserved
CODEC_PREFERENCE=PCMA,PCMU      # G.711 A-law first (Israel), mu-law as fallback
# ALLOWED_SOURCE_NETWORKS=198.51.100.0/24,203.0.113.9   # extra layer: only these sources may INVITE

# ---- limits --------------------------------------------------------------------
MAX_CALLS=5
MAX_CALL_SECONDS=1800

# ---- optional status endpoint -----------------------------------------------------
# STATUS_PORT=8080
# STATUS_TOKEN=                 # >=16 chars; GET /status with "Authorization: Bearer <token>", /healthz is open

# ---- optional: ring this bridge via a registered Yemot SIP account (type=sip mode) ----
# YEMOT_REGISTER_HOST=
# YEMOT_REGISTER_PORT=5060
# YEMOT_SIP_USER=               # accountID returned by CreateSipAccount
# YEMOT_SIP_PASSWORD=
# YEMOT_REGISTER_EXPIRES=120
